<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>924ddc37-2721-40bf-9dcb-d712e4f6772c</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Contoso</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="宛先ドメイン チェック" />
  <Description DefaultValue="送信前に宛先ドメインを許可リストと照合し、許可リストにないドメインが含まれる場合は確認ダイアログを表示します。" />
  <IconUrl DefaultValue="__BASE_URL__/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="__BASE_URL__/assets/icon-128.png" />
  <SupportUrl DefaultValue="__BASE_URL__/" />

  <AppDomains>
    <AppDomain>__BASE_URL__</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.12" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="__BASE_URL__/src/launchevent/launchevent.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <Runtimes>
            <!-- Outlook on the web / new Outlook: ブラウザーランタイム（HTML） -->
            <Runtime resid="WebViewRuntime.Url">
              <!-- classic Outlook on Windows: JavaScript ランタイム -->
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="WebViewRuntime.Url" />

            <!-- 送信時イベント。SendMode の選択肢:
                   SoftBlock  : ハンドラーが allowEvent:false を返すと送信を止める（既定・推奨）
                   Block      : SoftBlock と同様だが、ハンドラー未完了時も送信不可
                   PromptUser : allowEvent:false のとき Outlook 標準の「このまま送信」確認が出る -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="SoftBlock" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="__BASE_URL__/assets/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="__BASE_URL__/assets/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="__BASE_URL__/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="__BASE_URL__/src/launchevent/launchevent.html" />
          <bt:Url id="JSRuntime.Url" DefaultValue="__BASE_URL__/src/launchevent/launchevent.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="宛先ドメイン チェック" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Description" DefaultValue="送信前に宛先ドメインを許可リストと照合します。" />
        </bt:LongStrings>
      </Resources>

    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
